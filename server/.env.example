PORT=5000

# Origins allowed to call the API from a browser (comma separated)
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# At least 32 random characters. Generate one with: npm run setup
JWT_ACCESS_SECRET=

# Set to 1 when the API runs behind a reverse proxy
# TRUST_PROXY=1

# Optional: where the SQLite file lives
DB_PATH=./data/app.db
