    {
      "parameters": {
        "jsCode": "const body = $('Approve Job').first().json.body || {};\nconst row = $input.first().json || {};\nconst fail = (errors) => [{ json: { valid: false, errors } }];\n\nif (!row.jobId || row.jobId !== body.jobId || !body.token || String(row.reviewToken) !== String(body.token)) {\n  return fail(['This review link is not valid.']);\n}\nif (row.status !== 'Draft') return fail(['This job was already approved.']);\n\nconst errors = [];\n\n// Skills\nconst input = Array.isArray(body.skills) ? body.skills : [];\nif (input.length > 25) errors.push('Too many skills (maximum 25).');\nconst seen = new Set();\nconst skills = [];\nfor (const s of input.slice(0, 25)) {\n  const skill = String((s && s.skill) || '').trim().slice(0, 60);\n  const weight = Number(s && s.weight);\n  const type = s && s.type === 'Required' ? 'Required' : (s && s.type === 'Nice-to-have' ? 'Nice-to-have' : null);\n  if (!skill) { errors.push('A skill name is empty.'); continue; }\n  if (seen.has(skill.toLowerCase())) { errors.push(`\"${skill}\" is listed twice.`); continue; }\n  if (!Number.isInteger(weight) || weight < 1 || weight > 10) { errors.push(`The weight for \"${skill}\" must be a whole number from 1 to 10.`); continue; }\n  if (!type) { errors.push(`Choose a type for \"${skill}\".`); continue; }\n  seen.add(skill.toLowerCase());\n  skills.push({ skill, weight, type });\n}\nif (skills.filter(s => s.type === 'Required').length < 2) errors.push('Keep at least 2 required skills.');\n\n// Requirements\nconst years = Number(body.minExperienceYears);\nif (!Number.isFinite(years) || years < 0 || years > 30) errors.push('Minimum experience must be between 0 and 30 years.');\nconst education = String(body.education || '').trim().slice(0, 200);\n\n// Posts: re-run the leak check on whatever the recruiter edited\nconst names = skills.map(s => s.skill);\nconst escRe = (s) => s.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\nfunction leak(text) {\n  if (/\\b(weights?|weighted|priority|prioriti[sz]ed|points?|scores?|scoring|rankings?|ranked|importance)\\b/i.test(text)) return 'weight-related word';\n  if (/\\b\\d{1,3}\\s*(\\/|out of)\\s*(5|10|100)\\b/i.test(text)) return 'rating pattern';\n  if (/\\d\\s*%/.test(text)) return 'percentage';\n  for (const n of names) {\n    if (new RegExp(escRe(n) + '\\\\s*[:\\\\-–(]?\\\\s*\\\\d{1,3}\\\\b', 'i').test(text)) return `number next to \"${n}\"`;\n  }\n  return null;\n}\nfunction checkPost(label, wanted, text, max) {\n  if (!wanted) return '';\n  const t = String(text || '').trim();\n  if (!t) { errors.push(`The ${label} post is empty.`); return ''; }\n  if (t.length > max) errors.push(`The ${label} post is too long (maximum ${max} characters).`);\n  if (!t.includes(row.applyLink)) errors.push(`The ${label} post must keep the apply link.`);\n  const why = leak(t.split(row.applyLink).join(''));\n  if (why) errors.push(`The ${label} post seems to reveal scoring details (${why}). Please remove it.`);\n  return t;\n}\nconst platforms = String(row.platforms || '');\nconst telegramPost = checkPost('Telegram', platforms.includes('Telegram'), body.telegramPost, 4000);\nconst linkedinPost = checkPost('LinkedIn', platforms.includes('LinkedIn'), body.linkedinPost, 3000);\n\nif (errors.length) return fail(errors);\n\nreturn [{\n  json: {\n    valid: true,\n    jobId: row.jobId,\n    applyLink: row.applyLink,\n    skills,\n    minExperienceYears: years,\n    education,\n    telegramPost,\n    linkedinPost,\n    approvedAt: new Date().toISOString()\n  }\n}];"
      },
