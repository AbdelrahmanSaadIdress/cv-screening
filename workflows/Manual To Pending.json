    {
      "parameters": {
        "jsCode": "const v = $('Check Accept').first().json;\nconst raw = $input.first().json || {};\nconst row = {};\nfor (const [k, val] of Object.entries(raw)) row[String(k).trim()] = val;\n\nconst found = Boolean(row.applicationId) && String(row.applicationId).trim() === v.applicationId;\nconst status = String(row.status || \"\").trim();\nconst allowed = [\"Pending Review\", \"Interview Scheduled\", \"Accepted\"].includes(status);\nconst ok = found && allowed;\nconst reason = !found ? \"This application was not found.\"\n  : (!allowed ? 'This applicant cannot be accepted from the status \"' + status + '\".' : \"\");\n\nreturn [{ json: {\n  ok, reason,\n  applicationId: v.applicationId,\n  status,\n  name: String(row.applicantName || \"\").trim(),\n  email: String(row.applicantEmail || \"\").trim(),\n  role: String(row.appliedPosition || \"\").trim(),\n  alreadySent: Boolean(String(row.acceptedEmailSentAt || \"\").trim())\n} }];"
      },
      "type": "n8n-nodes-base.code",
